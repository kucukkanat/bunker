# Bunker systemd unit (the same one install.sh writes).
#
#   sudo useradd --system --home-dir /var/lib/bunker --shell /usr/sbin/nologin bunker
#   sudo install -m 0755 bunker /usr/local/bin/bunker
#   sudo install -D -m 0644 bunker.service /etc/systemd/system/bunker.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now bunker
#   sudo cat /var/lib/bunker/setup-code.txt
#
# Settings go in /etc/bunker/bunker.env (BUNKER_URL=https://..., BUNKER_LISTEN=:8080).

[Unit]
Description=Bunker - internal apps anyone can build
Documentation=https://kucukkanat.github.io/bunker/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bunker
Group=bunker
EnvironmentFile=-/etc/bunker/bunker.env
Environment=BUNKER_DATA_DIR=/var/lib/bunker
ExecStart=/usr/local/bin/bunker serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
LimitNOFILE=65536

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# Allows BUNKER_LISTEN=:443 / :80 without running as root.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ReadWritePaths=/var/lib/bunker
StateDirectory=bunker
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
