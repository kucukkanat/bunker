            ))}
          </ul>
          <p class="fine center"><a href={u('docs/security/threat-model/')}>Read the threat model, including the risks that remain →</a></p>
        </div>
      </section>

      <!-- PERFORMANCE -->
      <section class="perf">
        <div class="wrap">
          <div class="perf-grid">
            <div class="perf-copy">
              <p class="kicker">Small footprint</p>
              <h2>One binary. One folder. That’s the whole platform.</h2>
              <p>No Postgres, no Redis, no Kubernetes, no queue. Bunker is a pure-Go program with SQLite in WAL mode and a content-addressed file store. Files are compressed once at publish and served with ETags, so a small VM serves a big company.</p>
              <p class="fine">Back up one folder. Upgrade by replacing one file.</p>
            </div>
            <dl class="stats">
              <div><dt>Requests per second</dt><dd>~30k<small>on 4 cores</small></dd></div>
              <div><dt>Moving parts</dt><dd>1<small>binary, no CGO</small></dd></div>
              <div><dt>State</dt><dd>1<small>folder to back up</small></dd></div>
              <div><dt>Built for</dt><dd>5,000<small>people per VM</small></dd></div>
            </dl>
          </div>
        </div>
      </section>

      <!-- COMPARE -->
      <section class="compare">
        <div class="wrap">
          <div class="sec-head">
            <p class="kicker">How it compares</p>
            <h2>The ease of a builder. The control of your own server.</h2>
          </div>
          <div class="table-wrap" tabindex="0" role="region" aria-label="Comparison table">
            <table>
              <thead>
                <tr><th scope="col"><span class="sr">Capability</span></th><th scope="col" class="us">Bunker</th><th scope="col">Low-code SaaS</th><th scope="col">Static hosting tools</th></tr>
              </thead>
              <tbody>
                {compare.map(([k, a, b, c]) => (
                  <tr>
                    <th scope="row">{k}</th>
                    <td class={`us v-${a}`}>{mark(a)}</td>
                    <td class={`v-${b}`}>{mark(b)}</td>
                    <td class={`v-${c}`}>{mark(c)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="faq" id="faq">
        <div class="wrap faq-grid">
          <div class="sec-head left">
            <p class="kicker">Questions</p>
            <h2>Asked by IT, answered plainly.</h2>
            <p>Something missing? <a href={`${repo}/discussions`}>Ask on GitHub</a>.</p>
          </div>
          <div class="qs">
            {faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="final">
        <div class="wrap final-in">
          <img src={u('favicon.svg')} alt="" width="56" height="56" />
          <h2>Give yourself, your team or your company a safe place to build.</h2>
          <p>Free and open source. Up in minutes on a machine you control. Company sign-in whenever you want it.</p>
          <div class="ctas center">
            <a class="btn primary on-dark" href="#deploy">Deploy Bunker</a>
            <a class="btn ghost-dark" href={u('docs/start/introduction/')}>Read the docs</a>
          </div>
        </div>
      </section>
    </main>

