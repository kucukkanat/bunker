---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/landing.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${base}/${p}`;
const repo = 'https://github.com/kucukkanat/bunker';
const title = 'Bunker: your own private app cloud';
const description =
  'Your own private app cloud, for you, your team or your whole company. Drop a file or describe an app and get a private, shareable, sandboxed web app. Built-in accounts out of the box; Microsoft Entra ID, Google Workspace or OIDC when you want them. One Go binary, MIT licensed.';

const curl =
  'curl -fsSL https://raw.githubusercontent.com/kucukkanat/bunker/master/install.sh | sudo BUNKER_URL=https://bunker.example.com sh';
const docker = 'docker run -p 8080:8080 -v bunker:/data ghcr.io/kucukkanat/bunker';
const goinstall = 'go install github.com/kucukkanat/bunker/cmd/bunker@latest && bunker demo';
const fly = 'fly launch --from https://github.com/kucukkanat/bunker --copy-config';

const deployButtons = [
  {
    name: 'Azure',
    note: 'VM + managed disk + HTTPS',
    href: 'https://portal.azure.com/#create/Microsoft.Template/uri/https%3A%2F%2Fraw.githubusercontent.com%2Fkucukkanat%2Fbunker%2Fmaster%2Fdeploy%2Fazure%2Fazuredeploy.json',
    tag: 'Best for Microsoft 365',
  },
  { name: 'Render', note: 'Web service + 5 GB disk', href: 'https://render.com/deploy?repo=https://github.com/kucukkanat/bunker' },
  { name: 'Railway', note: 'Service + volume', href: 'https://railway.com/deploy/bunker' },
  {
    name: 'DigitalOcean',
    note: 'App Platform, data resets',
    href: 'https://cloud.digitalocean.com/apps/new?repo=https://github.com/kucukkanat/bunker/tree/master',
    tag: 'Demo only',
    demo: true,
  },
];

type Tile = { t: string; ext: string; d: string; preview?: boolean; ai?: boolean };
const tiles: Tile[] = [
  { t: 'A web page', ext: '.html', d: 'Published as it is. Links to popular CDN libraries are swapped for built-in copies.' },
  { t: 'A folder or zip', ext: 'folder · .zip', d: 'Finds index.html, even inside dist/ or build/. Root paths keep working.' },
  { t: 'React in one file', ext: '.jsx · .tsx', d: 'A single component becomes a running app. Bunker bundles it for you. No build step.' },
  { t: 'Docs and notes', ext: '.md', d: 'Markdown becomes a clean, readable page. A folder becomes a docs site.' },
  { t: 'Slides', ext: '.md · slides: true', d: 'Split a Markdown file into slides with --- and present from the browser.' },
  { t: 'A spreadsheet', ext: '.csv · .xlsx', d: 'Becomes a table app: search, sort, filter, chart and export. Every sheet is a tab.' },
  { t: 'A notebook', ext: '.ipynb', d: 'Rendered with its charts and outputs, ready to read.' },
  { t: 'A PDF', ext: '.pdf', d: 'Opens in a built-in viewer that works inside the sandbox.' },
  { t: 'Images and video', ext: '.png · .jpg · .mp4', d: 'A tidy gallery page your team can browse.' },
  { t: 'Describe it', ext: 'plain words', d: '“A holiday tracker where managers approve requests.” The AI builds a draft, offers to fix any errors the preview shows, and you publish.', ai: true },
];

// Real screenshots from a Bunker server with demo data (website/public/shots).
type Shot = { id: string; tab: string; img: string; dark?: string; alt: string; title: string; text: string; link?: [string, string] };
const shots: Shot[] = [
  {
    id: 'home', tab: 'Home', img: 'home', dark: 'home-dark',
    alt: 'Bunker home page: a greeting, a “Describe an app” box, a drop zone for files and folders, and cards for recent sites such as Q3 budget and Website launch.',
    title: 'Everything you made, in one place',
    text: 'Drop a file or folder, describe an app, or start from a template. Recent sites, favorites and public links are right there.',
  },
  {
    id: 'builder', tab: 'AI builder', img: 'builder', dark: 'builder-dark',
    alt: 'The site workspace: on the left a chat asking the builder to add a Review column; on the right a live draft preview of a kanban board with To do, In progress, Review and Done columns.',
    title: 'Ask for a change, watch the preview',
    text: 'The builder edits a draft and the preview updates beside it. Nothing is live until you publish. If the preview shows an error, it offers to fix it with one click.',
    link: ['docs/build/ai-builder/', 'The AI builder'],
  },
  {
    id: 'share', tab: 'Sharing', img: 'share',
    alt: 'The Share dialog for “Onboarding handbook”: five people with view or edit access, an organization-wide switch, and “Anyone with the link” switched on.',
    title: 'Share with people, or with a link',
    text: 'Add people or groups as viewers or editors. If your admin allows it, a public link lets you show a portfolio or a page to friends who don’t have an account.',
    link: ['docs/build/sharing/', 'Sharing and public links'],
  },
  {
    id: 'table', tab: 'Spreadsheets', img: 'table',
    alt: 'A table app made from q3-budget.csv: summary cards, a bar chart of plan by team, a search box and a sortable table.',
    title: 'A CSV becomes a table app',
    text: 'Drop a .csv or .xlsx and get search, filters, summary numbers and a chart. Every sheet becomes a tab, and people can export it again.',
  },
  {
    id: 'docs', tab: 'Docs', img: 'docs',
    alt: 'A docs site made from four Markdown files: a sidebar with page links and a page titled “Welcome to Fernhill”.',
    title: 'A folder of Markdown becomes a docs site',
    text: 'Navigation, headings and next-page links come for free. This handbook is four .md files in a folder.',
    link: ['docs/build/drop-anything/', 'Everything you can drop'],
  },
  {
    id: 'webhooks', tab: 'Webhooks', img: 'webhooks',
    alt: 'The Data tab of an Equipment requests app: a table of requests, including one added by a webhook, and two webhooks named “Power Automate: new starters” and “Nightly script: renewals”.',
    title: 'Data in from Power Automate, Zapier or a script',
    text: 'A webhook is a secret URL that adds whatever it receives to one of the app’s collections. Pages that show it update live.',
    link: ['docs/build/webhooks/', 'Inbound webhooks'],
  },
  {
    id: 'admin', tab: 'Admin', img: 'admin-people',
    alt: 'Admin, People: a list of people with admin switches and Disable buttons, plus Transfer sites and Invite people buttons.',
    title: 'People, and what happens when they leave',
    text: 'Invite people and choose admins. When someone leaves, disable them and move all their sites to a colleague in the same step. Sharing rules, AI, Microsoft 365 and the audit log are one tab away.',
    link: ['docs/admin/policy/', 'Policy and people'],
  },
  {
    id: 'setup', tab: 'First run', img: 'setup',
    alt: 'The setup page: “Welcome! Let’s set up Bunker” with a choice between “Just me or my team” and “Company sign-in”.',
    title: 'Set up in a minute',
    text: 'Start Bunker on a laptop and it opens this page in your browser. Choose built-in accounts or company sign-in, create the first admin, and you’re in.',
    link: ['docs/start/quickstart/', 'Quickstart'],
  },
  {
    id: 'signin', tab: 'Sign-in', img: 'signin', dark: 'signin-dark',
    alt: 'The Bunker sign-in page with email and password fields.',
    title: 'One quiet sign-in page',
    text: 'Built-in accounts with invite links, or your company’s Microsoft Entra ID, Google Workspace or OIDC. Apps never see a password or a token.',
    link: ['docs/sign-in/built-in/', 'Sign-in options'],
  },
];

const extras = [
  {
    t: 'Data from your other tools',
    d: 'Power Automate, Zapier, a form or a nightly script can post JSON to a secret webhook URL. It lands in the app’s data and open pages update live.',
    link: ['docs/build/webhooks/', 'Inbound webhooks'],
    icon: 'M4 12h5l2-5 3 10 2-5h4',
  },
  {
    t: 'Public when you want it',
    d: 'Share a portfolio or a page with friends, no accounts needed. Off until an admin allows it, and one switch closes every public link.',
    link: ['docs/build/sharing/', 'Public links'],
    icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zm-9 9h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z',
  },
  {
    t: 'A builder that checks its work',
    d: 'After each change the builder looks at the draft preview. If it shows an error, you get one click to have it fixed, before anyone else sees it.',
    link: ['docs/build/ai-builder/', 'The AI builder'],
    icon: 'M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8zM18 15l.9 2.1L21 18l-2.1.9L18 21l-.9-2.1L15 18l2.1-.9z',
  },
  {
    t: 'Looks like you from the start',
    d: 'One line of CSS gives an app Bunker’s fonts and clean light and dark styles, served by your own server, so even quick drafts look tidy without loading anything from the internet.',
    link: ['docs/sdk/overview/', 'The SDK and style kit'],
    icon: 'M5 19 10 5h4l5 14M7.5 13h9',
  },
  {
    t: 'Paste a GitHub link',
    d: 'Paste a public repository (or one folder of it) on Home and it becomes a site: build output, a Markdown handbook or a folder of spreadsheets.',
    link: ['docs/build/drop-anything/', 'Import from GitHub'],
    icon: 'M9 19c-4 1.5-4-2-6-2.5m12 5v-3.5a3 3 0 0 0-.8-2.3c2.7-.3 5.5-1.3 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.7 11.7 0 0 0-6 0C6.5 2.9 5.4 3.2 5.4 3.2a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.6c0 4.6 2.8 5.6 5.5 6a3 3 0 0 0-.8 2.3V21',
  },
  {
    t: 'Email when you have it',
    d: 'Point Bunker at any SMTP server and invites, password resets and notifications arrive by email. Without one, links are one click to copy.',
    link: ['docs/admin/email/', 'Email'],
    icon: 'M3 6h18v12H3zM3 7l9 6 9-6',
  },
  {
    t: 'AI with nothing to configure',
    d: 'Already exported ANTHROPIC_API_KEY or OPENAI_API_KEY? Bunker uses it. Running Ollama or LM Studio on the same machine? One click.',
    link: ['docs/admin/ai/', 'AI providers'],
    icon: 'M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8',
  },
  {
    t: 'On your phone’s home screen',
    d: 'Add Bunker to a phone or laptop like an app. Every screen works at phone size, in light and dark, with a keyboard or a screen reader.',
    link: ['docs/start/quickstart/', 'Quickstart'],
    icon: 'M8 2h8a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zM11 18h2',
  },
];

const templates = [
  ['✅', 'Requests & approvals'], ['🗂️', 'Team tracker'], ['📝', 'Sign-up sheet'], ['💬', 'Feedback'], ['📊', 'Quick poll'], ['📈', 'Dashboard'],
  ['👋', 'Directory & who’s out'], ['🗒️', 'Meeting notes'], ['💻', 'Equipment check-out'], ['📅', 'Room & desk booking'], ['📦', 'Inventory'],
  ['🚨', 'Incident log'], ['🧭', 'Onboarding checklist'], ['🎯', 'Goals & OKRs'], ['🙌', 'Kudos wall'], ['🥪', 'Lunch orders'],
];

const security = [
  { t: 'Opaque-origin sandbox', d: 'Every app runs in an iframe without allow-same-origin. It has no cookies, no storage and no reach into Bunker or other apps.', code: 'sandbox="allow-scripts allow-forms allow-modals allow-downloads"' },
  { t: 'Signed content tickets', d: 'App files are served under a short-lived HMAC ticket tied to the site, version and viewer. Revoke a share and the next request fails.', code: '/s/<site>/~r/<ticket>/index.html' },
  { t: 'No keys in pages', d: 'Data, AI and Microsoft 365 calls go through the parent frame with the viewer’s session. Uploads containing API keys are refused at publish time.', code: '422 secret_detected' },
  { t: 'Connection-Allowlist', d: 'CSP can’t stop WebRTC. On Chromium and Edge 152+ this header also blocks WebRTC, navigations and prefetch to anywhere but Bunker.', code: 'Connection-Allowlist: (response-origin)' },
  { t: 'Viewer-scoped Microsoft 365', d: 'An app sees SharePoint, Excel and OneDrive only with the viewer’s own rights, and only for scopes your admin allowed.', code: 'delegated · admin allowlist' },
  { t: 'Audit everything', d: 'Sign-ins, publishes, shares, views, data-rule and admin changes land in an indexed audit table, with every agent action marked as a token.', code: 'site.share · site.view · auth.login' },
  { t: 'SSRF-safe connections', d: 'Apps reach internal APIs only through named connections an admin defines. Private and metadata addresses are blocked by default.', code: 'bunker.connections.fetch("hr", { path: "/people" })' },
  { t: 'Your sign-in, your rules', d: 'Built-in accounts use argon2id and one-time invite links. Company sign-in is single-tenant only, and Bunker refuses settings that would let personal accounts in.', code: 'argon2id · tenant ≠ common' },
];

const compare: [string, string, string, string][] = [
  ['Anyone can build: drop a file or describe it', 'yes', 'partly', 'no'],
  ['Runs on your own servers', 'yes', 'no', 'varies'],
  ['Company sign-in on every app, included', 'yes', 'paid tier', 'extra setup'],
  ['Share each app with people and groups', 'yes', 'yes', 'no'],
  ['Apps sandboxed from each other and the internet', 'yes', 'varies', 'no'],
  ['Database, files and live updates built in', 'yes', 'yes', 'no'],
  ['Agents deploy through CLI and MCP', 'yes', 'rarely', 'partly'],
  ['Plain HTML you can take with you', 'yes', 'lock-in', 'yes'],
  ['Audit log', 'yes', 'paid tier', 'no'],
  ['Per-seat fees', 'none', 'per builder + per viewer', 'usually none'],
];

const faq = [
  {
    q: 'Do I need Microsoft 365 or SSO?',
    a: 'No. Bunker works out of the box with built-in accounts: you create the first admin in the setup page and invite people with one-time links. When you want company sign-in, switch on Microsoft Entra ID, Google Workspace or any OIDC provider, then turn built-in accounts off if you like.',
  },
  {
    q: 'Is it only for big companies?',
    a: 'No. Run it on a laptop or a five-dollar server for your own projects, share apps with a few friends or a small team, or put it in front of thousands of employees. Same binary.',
  },
  {
    q: 'Is Bunker ready for production?',
    a: 'Bunker is early and moving fast. Sign-in, sites, sharing, versions, the sandbox, the SDK, the AI builder, the CLI and MCP are in the code today. So are the dashboard, app types from Markdown to notebooks, templates, Microsoft 365 data, connections, webhooks, public links, MCP Apps, audit streaming and backups. Anything unfinished is marked Preview in the docs. Try it with a small group first.',
  },
  {
    q: 'Do we need wildcard DNS or a wildcard certificate?',
    a: 'No. Apps live at paths on one hostname, like bunker.corp.com/s/holiday-requests. One DNS record, one certificate. A separate content domain is optional for extra isolation.',
  },
  {
    q: 'Can apps be made public?',
    a: 'Only if an admin allows it. By default every request needs someone signed in to your Bunker. An admin can switch on public links in Admin → Sharing; then an owner can let anyone with the link view a site, like a portfolio or an event page. Public visitors see the published version only, can’t use the app’s data, and one switch closes every public link at once.',
  },
  {
    q: 'Which AI models can it use?',
    a: 'Your admin picks one: Anthropic Claude, OpenAI, Azure OpenAI or any OpenAI-compatible endpoint, including local models. Keys stay on the server. Each person and each site gets a daily allowance. Without a provider, everything except the AI parts still works.',
  },
  {
    q: 'What if an app author is malicious?',
    a: 'The sandbox stops an app from reaching your session, other apps or the internet on every modern browser. On Chromium and Edge it also blocks WebRTC and navigation leaks. The security docs list what remains, honestly.',
  },
  {
    q: 'How many people can one server handle?',
    a: 'Bunker is built for 500 to 5,000 people on one small VM. It is one Go binary and one SQLite database, with content-addressed files served precompressed.',
  },
  {
    q: 'What does it cost?',
    a: 'Nothing. Bunker is MIT licensed. You pay for the machine it runs on and, if you turn it on, your AI provider.',
  },
  {
    q: 'What happens to our apps if we stop using Bunker?',
    a: 'They are plain HTML, CSS and JavaScript files. Download any version and host it anywhere.',
  },
  {
    q: 'What happens to someone’s apps when they leave?',
    a: 'When an admin disables a person, Bunker asks who should get their sites and moves them in the same step, so nothing is orphaned. You can also archive apps nobody has opened for a while: owners get a heads-up a week before, and an editor can bring one back with one click.',
  },
];

const mark = (v: string) => (v === 'yes' ? '✓' : v === 'no' ? '—' : v);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F7F4EC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121714" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={u('apple-touch-icon.png')} />
    <link rel="canonical" href="https://kucukkanat.github.io/bunker/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://kucukkanat.github.io/bunker/og.png" />
    <meta property="og:url" content="https://kucukkanat.github.io/bunker/" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Share the theme choice with the docs (Starlight uses the same key).
      try {
        var t = localStorage.getItem('starlight-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <div class="wrap nav-in">
        <a class="brand" href={u('')} aria-label="Bunker home">
          <img src={u('favicon.svg')} alt="" width="30" height="30" />
          <span>bunker</span>
        </a>
        <nav aria-label="Main">
          <a href="#tour" class="hide-sm">Tour</a>
          <a href="#apps" class="hide-sm">Product</a>
          <a href="#agents" class="hide-sm">Agents</a>
          <a href="#security" class="hide-sm">Security</a>
          <a href="#deploy" class="hide-sm">Deploy</a>
          <a href={u('docs/start/introduction/')}>Docs</a>
          <a href={repo} class="gh" aria-label="Bunker on GitHub">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            <span class="hide-sm">GitHub</span>
          </a>
          <button class="theme" type="button" aria-label="Switch between light and dark" data-theme-toggle>
            <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
            <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- HERO -->
      <section class="hero">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span> Open source · MIT · Self-hosted</p>
            <h1>Your own private <span class="ground">app cloud.</span></h1>
            <p class="sub">For you, your team, or your whole company.</p>
            <p class="lede">
              Drop in a file or folder, or describe an app in plain words, and get a private web app you can share with a link. Every app is sandboxed. Sign in with built-in accounts from minute one, and switch on Microsoft Entra ID, Google Workspace or OIDC when your company is ready.
            </p>
            <div class="ctas">
              <a class="btn primary" href="#deploy">Deploy in one click</a>
              <a class="btn" href={u('docs/start/quickstart/')}>See how it works <span aria-hidden="true">→</span></a>
            </div>
            <ul class="facts" aria-label="At a glance">
              <li><b>1</b> Go binary</li>
              <li><b>1</b> data folder</li>
              <li><b>0</b> SSO required</li>
            </ul>
          </div>

          <figure class="stage">
            <div class="win">
              <div class="win-bar" aria-hidden="true">
                <span class="lights"><i></i><i></i><i></i></span>
                <span class="addr"><svg viewBox="0 0 16 16" width="11" height="11"><path fill="currentColor" d="M4 7V5a4 4 0 1 1 8 0v2h1v8H3V7h1zm2 0h4V5a2 2 0 1 0-4 0v2z"/></svg> bunker.fernhill.example</span>
              </div>
              <div class="vid">
                <video
                  data-walk
                  muted
                  loop
                  playsinline
                  preload="none"
                  width="1280"
                  height="800"
                  poster={u('shots/walkthrough-poster.webp')}
                  aria-label="Screen recording: a folder is dropped on the Bunker home page, the site goes live, and it is shared with two colleagues."
                >
                  <source src={u('shots/walkthrough.webm')} type="video/webm" />
                  <source src={u('shots/walkthrough.mp4')} type="video/mp4" />
                </video>
                <button class="vid-ctl" type="button" data-walk-toggle data-state="paused" hidden>
                  <svg class="i-pause" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M4 3h3v10H4zm5 0h3v10H9z"/></svg>
                  <svg class="i-play" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M5 3l8 5-8 5z"/></svg>
                  <span data-walk-label>Play</span>
                </button>
              </div>
            </div>
            <figcaption class="stage-cap"><b>A real recording, not a mock-up:</b> drop a folder, it’s live, share it.</figcaption>
          </figure>
        </div>
      </section>

      <!-- TOUR -->
      <section id="tour" class="tour" aria-labelledby="tour-h">
        <div class="wrap">
          <div class="sec-head">
            <p class="kicker">See it</p>
            <h2 id="tour-h">This is what it looks like.</h2>
            <p>Real screenshots of Bunker running the code on GitHub today, with a made-up company’s data. No mock-ups.</p>
          </div>
